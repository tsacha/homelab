{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "flux": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)dl\\.sh",
        "(^|/)talos\\.yaml"
      ],
      "matchStrings": [
        ".+?_VERSION=\"?v?(?<currentValue>.*?)\"? # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) packageName=(?<packageName>.*?)\\n"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Fix duplicate registryUrls for Cilium",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cilium"],
      "registryUrls": ["https://helm.cilium.io"]
    }
  ]
}
