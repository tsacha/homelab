{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "flux": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tasks/talos\\.yaml$/"],
      "matchStrings": ["(?<depType>TALOS_VERSION|KUBERNETES_VERSION): (?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tasks/.+\\.yaml$/"],
      "matchStrings": ["export \\w+=(?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Cilium 1.20 requires Gateway API v1 TLSRoute and ReferenceGrant, so the two must land together",
      "matchPackageNames": ["cilium", "cilium/cilium", "kubernetes-sigs/gateway-api"],
      "groupName": "cilium and gateway-api"
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cilium"],
      "registryUrls": ["https://helm.cilium.io"]
    }
  ]
}
